      "why": {
        "headline": "Don't translate “it is”. Choose the Spanish weather pattern.",
        "intro": "English can use “it is” again and again. Spanish spreads weather across a few small families.",
        "families": [
          {
            "icon": "☀️🔥🥶💨",
            "name": "HACE",
            "examples": "sol · calor · frío · viento"
          },
          {
            "icon": "☁️",
            "name": "ESTÁ",
            "examples": "nublado"
          },
          {
            "icon": "⛈️",
            "name": "HAY",
            "examples": "tormenta"
          },
          {
            "icon": "🌧️❄️",
            "name": "ACTION",
            "examples": "llueve · nieva · está lloviendo · está nevando"
          }
        ],
        "remember": "First ask yourself: which Spanish family does this weather idea belong to?",
        "more_title": "Why lluvia, llover and lloviendo are different",
        "more": "Lluvia is a noun: rain. Llover is the verb: to rain. Lloviendo is the verb form used in está lloviendo: it is raining. Do not try to turn LLUVIA into LLOVIENDO letter by letter."
      },
